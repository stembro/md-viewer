<Window x:Class="MarkdownViewer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 xmlns:browsing="clr-namespace:MarkdownViewer.Browsing"
 Title="Markdown Viewer" Width="1180" Height="820" MinWidth="800" MinHeight="540"
 WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDrop="Window_Drop" PreviewDragOver="Window_DragOver"
 PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="PanelSplitterStyle" TargetType="GridSplitter">
   <Setter Property="Width" Value="6"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="SizeWE"/>
   <Setter Property="ResizeDirection" Value="Columns"/><Setter Property="ResizeBehavior" Value="PreviousAndNext"/><Setter Property="ShowsPreview" Value="False"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Line}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
   <Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MenuSeparatorStyle" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Line}" Margin="8,4"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DocumentTabStyle" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="TabPlate" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
     <Grid><Border x:Name="ActiveLine" Height="2" Background="Transparent" VerticalAlignment="Top"/><ContentPresenter Margin="0,2,0,0"/></Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource Surface}"/><Setter TargetName="ActiveLine" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <PathGeometry x:Key="FolderGlyph" Figures="M1,4 V2 H6 L8,4 H15 V13 H1 Z"/>
  <PathGeometry x:Key="MarkdownFileGlyph" Figures="M3,1 H9 L13,5 V15 H3 Z M9,1 V5 H13"/>
  <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ToggleButton x:Name="Expander" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="Transparent" Padding="2,6"><TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Border>
       <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="Selection" Grid.Column="1" Padding="6,7" CornerRadius="4" Background="Transparent"><ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
     <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.Column="1" Margin="1,0,0,0"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger SourceName="Selection" Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type browsing:FolderNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource FolderTreeItemStyle}">
   <Grid ToolTip="{Binding ToolTip}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="NodeIcon" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
     <Path x:Name="FileIcon" Data="{StaticResource MarkdownFileGlyph}" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
     <Path x:Name="FolderIcon" Data="{StaticResource FolderGlyph}" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" Visibility="Collapsed"/>
    </Grid>
    <TextBlock x:Name="NodeName" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/>
   </Grid>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter TargetName="FileIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="FolderIcon" Property="Visibility" Value="Visible"/><Setter TargetName="NodeName" Property="FontWeight" Value="SemiBold"/></DataTrigger>
    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter TargetName="NodeIcon" Property="Visibility" Value="Collapsed"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
  <Style x:Key="EditorMenuItemStyle" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="Plate" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><Grid MinWidth="170"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/><TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" Margin="24,0,0,0"/></Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Window.Icon><DrawingImage><DrawingImage.Drawing><DrawingGroup>
  <GeometryDrawing Brush="#376A54" Geometry="M 4,0 L 28,0 Q 32,0 32,4 L 32,28 Q 32,32 28,32 L 4,32 Q 0,32 0,28 L 0,4 Q 0,0 4,0"/>
  <GeometryDrawing Brush="White" Geometry="M 6,10 L 9,10 13,15 17,10 20,10 20,23 17,23 17,15 13,20 9,15 9,23 6,23 Z M 23,10 L 26,10 26,18 29,18 24.5,23 20,18 23,18 Z"/>
 </DrawingGroup></DrawingImage.Drawing></DrawingImage></Window.Icon>
 <Grid x:Name="WindowLayout" SizeChanged="WindowLayout_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,0">
   <DockPanel LastChildFill="True">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
     <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" Click="Back_Click" IsEnabled="False"/>
     <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" Click="Forward_Click" IsEnabled="False"/>
     <Border Width="1" Height="22" Background="{DynamicResource Line}" Margin="9,0"/>
     <Button Click="Open_Click" ToolTip="Open Markdown file (Ctrl+O)"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Open" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="RecentButton" Style="{StaticResource IconButton}" Width="26" Content="&#xE70D;" ToolTip="Recent files" AutomationProperties.Name="Recent files" Click="Recent_Click"/>
     <Button x:Name="FolderButton" Click="ChooseFolder_Click" ToolTip="Open folder (Ctrl+Shift+O)"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderGlyph}" Width="14" Height="12" Stretch="Uniform" Stroke="{DynamicResource Ink}" StrokeThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Folder"/></StackPanel></Button>
     <Border Width="1" Height="22" Background="{DynamicResource Line}" Margin="9,0"/>
     <Button x:Name="FilesToggleButton" Style="{StaticResource IconButton}" ToolTip="Show files (Ctrl+Shift+B)" AutomationProperties.Name="Toggle files panel" Click="Files_Click"><Path Data="M1,1 H15 V13 H1 Z M6,1 V13" Width="16" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <Button x:Name="ModeButton" Content="Edit" ToolTip="Edit this Markdown document" AutomationProperties.Name="Edit document" Click="Mode_Click" IsEnabled="False"/>
     <Button x:Name="SaveButton" Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save now (Ctrl+S)" AutomationProperties.Name="Save document" Click="SaveButton_Click" IsEnabled="False"/>
     <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Find in document (Ctrl+F)" AutomationProperties.Name="Find" Click="Find_Click"/>
     <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE708;" ToolTip="Switch to dark theme" AutomationProperties.Name="Toggle theme" Click="Theme_Click"/>
     <Border Width="1" Height="22" Background="{DynamicResource Line}" Margin="9,0"/>
     <Button Style="{StaticResource IconButton}" Content="&#xE738;" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out" Click="ZoomOut_Click"/>
     <Button x:Name="ZoomButton" Content="100%" Width="55" Padding="2,8" ToolTip="Reset zoom (Ctrl+0)" Click="ZoomReset_Click"/>
     <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" Click="ZoomIn_Click"/>
     <Button x:Name="OutlineToggleButton" Style="{StaticResource IconButton}" ToolTip="Show outline (Ctrl+Shift+L)" AutomationProperties.Name="Toggle document outline" Click="Outline_Click"><Path Data="M1,1 H15 V13 H1 Z M10,1 V13" Width="16" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button>
     <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More actions" AutomationProperties.Name="More actions" Click="More_Click"/>
    </StackPanel>
    <TextBlock x:Name="DocumentName" Text="Markdown Viewer" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0"/>
   </DockPanel>
  </Border>
  <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,8">
   <DockPanel LastChildFill="False">
    <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <TextBox x:Name="FindBox" Width="260" Padding="8,5" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged" AutomationProperties.Name="Search document"/>
    <Button Content="Previous" Click="FindPrevious_Click"/><Button Content="Next" Click="FindNext_Click"/>
    <TextBlock x:Name="FindResult" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="10,0"/>
    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close find (Esc)" AutomationProperties.Name="Close find" Click="FindClose_Click"/>
   </DockPanel>
  </Border>
  <Border x:Name="Notice" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Panel}" Padding="18,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
   <DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Click="NoticeClose_Click"/><TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <Grid x:Name="NavigationLayout" Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilesColumn" Width="0" MaxWidth="480"/><ColumnDefinition x:Name="FilesSplitterColumn" Width="0"/><ColumnDefinition x:Name="DocumentColumn" Width="*" MinWidth="360"/><ColumnDefinition x:Name="OutlineSplitterColumn" Width="0"/><ColumnDefinition x:Name="OutlineColumn" Width="0" MaxWidth="480"/></Grid.ColumnDefinitions>
   <Border x:Name="FilesSidebar" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="22,12,10,4">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" Click="Files_Click" ToolTip="Hide files" AutomationProperties.Name="Hide files panel"/>
      <TextBlock Text="FILES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
     </DockPanel>
     <Grid x:Name="FolderPane" Grid.Row="1" Margin="12,8,8,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="6,0,0,10">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="NewDocumentButton" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE710;" Click="NewDocument_Click" ToolTip="New Markdown file" AutomationProperties.Name="New Markdown file" IsEnabled="False"/>
        <Button x:Name="RefreshFolderButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE72C;" Click="RefreshFolder_Click" ToolTip="Refresh folder tree" AutomationProperties.Name="Refresh folder tree" IsEnabled="False"/>
        <Button x:Name="CloseFolderButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" Click="CloseFolder_Click" ToolTip="Close folder" AutomationProperties.Name="Close folder" IsEnabled="False"/>
       </StackPanel>
       <TextBlock x:Name="FolderNameText" Text="No folder open" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <TreeView x:Name="FolderTree" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource FolderTreeItemStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="FolderTree_SelectedItemChanged" TreeViewItem.Expanded="FolderTree_Expanded" PreviewKeyDown="FolderTree_PreviewKeyDown" ContextMenuOpening="FolderTree_ContextMenuOpening" AutomationProperties.Name="Markdown files and folders">
       <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
       <TreeView.Template><ControlTemplate TargetType="TreeView"><Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></TreeView.Template>
      </TreeView>
      <StackPanel x:Name="FolderEmpty" Grid.Row="1" Margin="14,20,12,0" VerticalAlignment="Top">
       <TextBlock x:Name="FolderEmptyText" Text="Keep your notes within reach. Open a folder to browse its Markdown files." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" LineHeight="20" Margin="0,0,0,14"/>
       <Button Content="Open a folder" Click="ChooseFolder_Click" HorizontalAlignment="Left" Background="{DynamicResource Hover}" Foreground="{DynamicResource Accent}"/>
      </StackPanel>
     </Grid>
     <StackPanel Grid.Row="2" Margin="26,12,16,16"><TextBlock Text="A little space to read." Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="MARKDOWN VIEWER" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,7,0,0"/></StackPanel>
    </Grid>
   </Border>
   <GridSplitter x:Name="FilesSplitter" Grid.Column="1" Style="{StaticResource PanelSplitterStyle}" DragCompleted="FilesSplitter_DragCompleted" KeyUp="PanelSplitter_KeyUp" ToolTip="Resize files panel" AutomationProperties.Name="Resize files panel"/>
   <GridSplitter x:Name="OutlineSplitter" Grid.Column="3" Style="{StaticResource PanelSplitterStyle}" DragCompleted="OutlineSplitter_DragCompleted" KeyUp="PanelSplitter_KeyUp" ToolTip="Resize outline panel" AutomationProperties.Name="Resize outline panel"/>
   <Border x:Name="OutlineSidebar" Grid.Column="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
     <Grid x:Name="OutlinePane" Margin="12,12,10,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="10,0,0,12">
       <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" Click="Outline_Click" ToolTip="Hide outline" AutomationProperties.Name="Hide document outline"/>
       <TextBlock Text="ON THIS PAGE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1">
      <ListBox x:Name="OutlineList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Outline_SelectionChanged" AutomationProperties.Name="Document outline">
       <ListBox.Template><ControlTemplate TargetType="ListBox">
        <Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border>
       </ControlTemplate></ListBox.Template>
       <ListBox.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding Text}" ToolTip="{Binding Text}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis"/>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="OutlineEmpty" Text="Headings will appear here." FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,8" TextWrapping="Wrap"/>
      </Grid>
     </Grid>
   </Border>
   <Grid Grid.Column="2" Background="{DynamicResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="TabBar" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
     <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="42" MaxHeight="62" ItemContainerStyle="{StaticResource DocumentTabStyle}" SelectionChanged="TabList_SelectionChanged" ContextMenuOpening="TabList_ContextMenuOpening" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Open documents">
      <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
      <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid MinWidth="110" MaxWidth="230" Height="40" Margin="12,0,4,0" ToolTip="{Binding Description}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Mode}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Indicator}" Foreground="{DynamicResource Accent}" Margin="7,0,0,0" VerticalAlignment="Center"/>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="28" FontSize="10" Content="&#xE711;" Margin="6,0,0,0" Click="CloseTab_Click" ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close document tab"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Border>
    <Grid x:Name="DocumentSurface" Grid.Row="1">
    <wv:WebView2 x:Name="Reader" Visibility="Collapsed" DefaultBackgroundColor="White" AllowDrop="False" AllowExternalDrop="True"/>
    <Border x:Name="EditorPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,6">
       <WrapPanel VerticalAlignment="Center">
        <WrapPanel.Resources>
         <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinWidth" Value="30"/>
         </Style>
        </WrapPanel.Resources>
        <Button Content="Heading ▾" ToolTip="Choose a heading level" AutomationProperties.Name="Heading style" Tag="headings" Click="EditorMenu_Click"/>
        <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="5,0"/>
        <Button Content="B" FontWeight="Bold" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" Tag="bold" Click="Format_Click"/>
        <Button Content="I" FontStyle="Italic" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" Tag="italic" Click="Format_Click"/>
        <Button Content="S̶" ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough" Tag="strike" Click="Format_Click"/>
        <Button Content="&lt;/&gt;" FontFamily="Consolas" ToolTip="Inline code" AutomationProperties.Name="Inline code" Tag="code" Click="Format_Click"/>
        <Button FontFamily="Segoe MDL2 Assets" Content="&#xE71B;" ToolTip="Insert link (Ctrl+K)" AutomationProperties.Name="Insert link" Tag="link" Click="Format_Click"/>
        <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="5,0"/>
        <Button Content="List ▾" ToolTip="Bullet list, numbered list, or checklist" AutomationProperties.Name="List style" Tag="lists" Click="EditorMenu_Click"/>
        <Button Content="❞" FontSize="16" ToolTip="Block quote" AutomationProperties.Name="Block quote" Tag="quote" Click="Format_Click"/>
        <Button Content="Insert ▾" ToolTip="Code block, image, table, or divider" AutomationProperties.Name="Insert Markdown" Tag="insert" Click="EditorMenu_Click"/>
        <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="5,0"/>
        <Button x:Name="EditorUndoButton" FontFamily="Segoe MDL2 Assets" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Tag="undo" Click="Format_Click" IsEnabled="False"/>
        <Button x:Name="EditorRedoButton" FontFamily="Segoe MDL2 Assets" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Tag="redo" Click="Format_Click" IsEnabled="False"/>
       </WrapPanel>
      </Border>
      <Grid x:Name="EditorHost" Grid.Row="1">
       <Grid.Resources>
        <Style TargetType="ScrollBar">
         <Setter Property="Width" Value="12"/>
         <Setter Property="Background" Value="{DynamicResource Surface}"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
           <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb>
             <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border x:Name="Grip" Background="{DynamicResource Line}" CornerRadius="4" Margin="2" MinHeight="20"/>
              <ControlTemplate.Triggers>
               <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Muted}"/></Trigger>
               <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
              </ControlTemplate.Triggers>
             </ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
           </Track>
          </Grid>
          <ControlTemplate.Triggers>
           <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand"/>
            <Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand"/>
           </Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
         <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
        </Style>
       </Grid.Resources>
      </Grid>
     </Grid>
    </Border>
    <Grid x:Name="Welcome" Background="{DynamicResource Surface}">
     <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,20,40,60">
      <Border Background="{DynamicResource Panel}" CornerRadius="16" Width="76" Height="76" HorizontalAlignment="Left" Margin="0,0,0,28"><TextBlock Text="M↓" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Just you and the words." FontFamily="Georgia" FontSize="31" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <TextBlock Text="A quiet home for your Markdown. Open a file to give your notes, docs, and ideas room to breathe." Foreground="{DynamicResource Muted}" FontSize="15" LineHeight="25" TextWrapping="Wrap" Margin="0,0,0,26"/>
      <StackPanel Orientation="Horizontal"><Button Content="Open a Markdown file" Background="{DynamicResource Hover}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Padding="18,12" Margin="0" Click="Open_Click"/><TextBlock Text="Ctrl + O" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/></StackPanel>
      <TextBlock Text="Or drop a .md file anywhere in this window" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,20,0,0"/>
     </StackPanel>
    </Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,0">
   <DockPanel><TextBlock x:Name="DocumentStats" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"/><TextBlock x:Name="StatusText" Text="Ready to read" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  </Border>
 </Grid>
</Window>
