<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <Compile Include="../../src/MarkdownViewer/Rendering/*.cs" Link="Rendering/%(Filename)%(Extension)" />
    <Compile Include="../../src/MarkdownViewer/MarkdownTextFile.cs" Link="MarkdownTextFile.cs" />
  </ItemGroup>
</Project>
